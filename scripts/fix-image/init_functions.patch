+# Load the modules needed for USB mass storage and USB input devices.
+# This is intentionally safe to call over and over again so that devices
+# which are plugged in *after* boot (hubs, keyboards, USB sticks) get
+# picked up. See usb_hotplug_rescan() below.
+load_usb_modules() {
+	modprobe usb-storage 2>/dev/null || true
+	modprobe uas 2>/dev/null || true
+	modprobe hid-generic 2>/dev/null || true
+	modprobe usbhid 2>/dev/null || true
+	modprobe evdev 2>/dev/null || true
+
+	# Ask every SCSI host to rescan its buses. This catches USB disks
+	# that were attached while usb-storage was being loaded.
+	for host in /sys/class/scsi_host/host*; do
+		[ -e "$host/scan" ] && echo "- - -" > "$host/scan" 2>/dev/null || true
+	done
+}
+
+# Full hot-plug rescan: load modules, rescan SCSI, and let mdev create
+# device nodes for anything that has appeared since the last scan.
+usb_hotplug_rescan() {
+	load_usb_modules
+	mdev -s 2>/dev/null || true
+}
+
+# Software "unplug/replug": toggle the kernel USB port `disable` attribute,
+# which makes the hub drop and re-enumerate whatever is attached. This
+# recovers devices whose first enumeration times out
+# ("device descriptor read/64, error -110") without physically replugging.
+usb_port_reset() {
+	local p
+	local ports=""
+
+	for p in /sys/bus/usb/devices/*/*:*/*-port*/disable; do
+		[ -e "$p" ] || continue
+		ports="$ports $p"
+	done
+	[ -z "$ports" ] && return 0
+
+	echo "$LOG_PREFIX Resetting USB port(s) to re-enumerate:$ports"
+	for p in $ports; do echo 1 > "$p" 2>/dev/null || true; done
+	sleep 2
+	for p in $ports; do echo 0 > "$p" 2>/dev/null || true; done
+	sleep 2
+	usb_hotplug_rescan
+}
+
+# Last resort: rebind the dwc2 host controller, resetting the whole USB bus.
+usb_controller_reset() {
+	local drv="/sys/bus/platform/drivers/dwc2"
+	local d name
+	[ -d "$drv" ] || return 0
+
+	for d in "$drv"/*; do
+		[ -L "$d" ] || continue
+		name="${d##*/}"
+		echo "$LOG_PREFIX Rebinding USB controller $name"
+		echo "$name" > "$drv/unbind" 2>/dev/null || continue
+		sleep 1
+		echo "$name" > "$drv/bind" 2>/dev/null || true
+	done
+	sleep 3
+	usb_hotplug_rescan
+}
