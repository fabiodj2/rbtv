[Unit]
Description=rx3-analyze: Tier-2 heavy analysis for track %i (manual trigger only)
# Deliberately NOT in [Install] / WantedBy anything -- this unit is never
# enabled and never auto-starts. It exists to be started by hand or by a
# future operator action:
#   systemctl start rx3-analyze-heavy@<track-id>.service
# with RX3_ANALYZE_HEAVY_AUDIO pointing at the file, e.g. via a drop-in or
# `systemctl set-environment` before the start.

[Service]
Type=oneshot
# %i is the track id; the audio path is read from the environment because
# systemd template units cannot carry two parameters cleanly. Set it with:
#   systemctl set-environment RX3_ANALYZE_HEAVY_AUDIO=/media/usb1/.../track.wav
# immediately before starting this instance.
ExecStart=/usr/local/bin/rx3-analyze-heavy.sh ${RX3_ANALYZE_HEAVY_AUDIO} %i

# ---- the safeguards the OOM near-miss made non-negotiable ----
# Hard ceiling: measured RSS was 1.1-1.4 GiB; this gives headroom but still
# caps it well below "can starve rbp".
MemoryMax=1536M
MemoryHigh=1200M
# Killed FIRST if the kernel needs a victim -- never rbp. This is the
# inverse of what almost happened during benchmarking.
OOMScoreAdjust=900
# Measured: a free scheduler put this on an A72 and finished 4.6x faster
# than pinned to an A53 (80s vs 372s). Let it float; do not CPUAffinity-pin
# it to the little cores.
Nice=19
CPUWeight=10
User=orangepi
Group=orangepi
