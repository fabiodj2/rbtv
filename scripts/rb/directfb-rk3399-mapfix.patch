 extern FBDev *dfb_fbdev;   /* defined further below */
 
 
+/* Return the physical framebuffer mapping size, bypassing LD_PRELOAD. */
+static size_t
+fbdev_physical_map_length( int fd, size_t fallback )
+{
+     struct fb_fix_screeninfo real;
+
+     memset( &real, 0, sizeof(real) );
+
+     if (syscall( SYS_ioctl, fd, FBIOGET_FSCREENINFO, &real ) == 0 &&
+         real.smem_len > fallback)
+          return real.smem_len;
+
+     return fallback;
+}
 
