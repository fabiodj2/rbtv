+/* Publish the converted/scaled frame into the physical fb (or the shared
+ * shm file in window mode).  Shared by the flip path (full-surface swap)
+ * and the update path (partial/BLIT updates, which is what rbp actually
+ * uses for most redraws) so the frame is always presented regardless of
+ * which path DirectFB's core takes.  Chromebit: rotation is 0, but the
+ * RGB565->RGB32 scale/convert is still required, so gate on rot_enable. */
+static DFBResult
+publish_rotated_frame( CoreSurfaceBufferLock *lock )
+{
+     FBDevShared *shared = dfb_fbdev->shared;
+     CoreLayerRegionConfig *config = &shared->config;
+     int sw  = config->width  ? config->width  : 1280;
+     int sh  = config->height ? config->height : 800;
+     int spitch = lock->pitch ? lock->pitch : shared->fix.line_length;
+     int fw  = shared->rot_fw;
+     int fh  = shared->rot_fh;
+     int fpitch = shared->rot_fpitch;
+     int idx = 0;
+
+     if (!shared->rot_enable || !shared->rot_surface)
+          return DFB_OK;
+
+     /* Chromebit/RK3288: the VOP does not present the panned buffer (the
+      * fb yoffset / plane src_y is ignored by the hardware here), so always
+      * render into physical buffer 0 and keep the pan at 0.  The frame is
+      * still read from rot_surface + lock->offset (DirectFB cycles its own
+      * buffers); only the destination is pinned. */
+     idx = 0;
+
+     fbdev_rotate_primary( (unsigned char*)shared->rot_surface + lock->offset,
+                           sw, sh, spitch,
+                           dfb_fbdev->framebuffer_base + idx * fh * fpitch,
+                           fw, fh, fpitch,
+                           shared->rot_deg );
+
+     /* the pixels are already in the fb; panning just selects the buffer.
+      * Don't propagate a pan error - the frame is written either way. */
+     dfb_fbdev_pan( config->source.x, config->source.y, false );
+
+     return DFB_OK;
+}
+
+static DFBResult
+primaryUpdateRegion( CoreLayer             *layer,
+                     void                  *driver_data,
+                     void                  *layer_data,
+                     void                  *region_data,
+                     CoreSurface           *surface,
+                     const DFBRegion       *update,
+                     CoreSurfaceBufferLock *lock )
+{
+     D_DEBUG_AT( FBDev_Primary, "%s()\n", __FUNCTION__ );
+
+     if (dfb_fbdev->shared->rot_enable) {
+          static int _updn = 0;
+          if (_updn < 8) {
+               FILE*f=fopen("/tmp/flipdbg.log","a");
+               if(f){ fprintf(f,"UPDATE %d cfg=%dx%d spitch=%d off=%d\n",
+                              _updn, dfb_fbdev->shared->config.width,
+                              dfb_fbdev->shared->config.height, lock->pitch,
+                              (int)lock->offset); fclose(f); }
+          }
+          _updn++;
+          return publish_rotated_frame( lock );
+     }
+     return DFB_OK;
+}
